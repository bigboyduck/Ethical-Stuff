    switchBg.BackgroundColor3 = initialState and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(45, 48, 60)
    knob.Position = initialState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
