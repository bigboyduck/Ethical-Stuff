-- // Find Tycoon
local myTycoon = nil

local function findMyTycoon()
    local tycoonFolder = workspace:FindFirstChild("Tycoon")
    if not tycoonFolder then return nil end
    local tycoons = tycoonFolder:FindFirstChild("Tycoons")
    if not tycoons then return nil end

    for _, tycoon in ipairs(tycoons:GetChildren()) do
        local basement = tycoon:FindFirstChild("Basement")
        if basement then
            local profile = basement:FindFirstChild("ProfileAtt")
            if profile then
                local bb = profile:FindFirstChild("BillboardGui")
                if bb then
                    for _, obj in ipairs(bb:GetDescendants()) do
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                            if obj.Text == player.DisplayName or obj.Text == player.Name then
                                return tycoon
                            end
                        end
                        if obj.Name == player.DisplayName or obj.Name == player.Name then
                            return tycoon
                        end
                        if obj:IsA("ImageLabel") and obj.Image ~= "" then
                            if string.find(obj.Image, tostring(player.UserId)) then
                                return tycoon
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // Helper Functions
local function fireTouchInterest(touchInterest)
    if not touchInterest or not firetouchinterest then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local part = touchInterest.Parent
    if not part then return end
    pcall(function()
        firetouchinterest(hrp, part, 0)
        task.wait()
        firetouchinterest(hrp, part, 1)
    end)
end

local function getMarketMultiplier(tycoon)
    local essentials = tycoon:FindFirstChild("Essentials")
    if not essentials then return 0 end
    local shop = essentials:FindFirstChild("Shop")
    if not shop then return 0 end
    local md = shop:FindFirstChild("MarketDisplay")
    if not md then return 0 end
    local sg = md:FindFirstChild("SurfaceGui")
    if not sg then return 0 end
    local frame = sg:FindFirstChild("Frame")
    if not frame then return 0 end
    local mf = frame:FindFirstChild("MultipleFrame")
    if not mf then return 0 end
    local mt = mf:FindFirstChild("MultipleText")
    if not mt then return 0 end
    local num = tonumber(string.match(mt.Text, "([%d%.]+)"))
    return num or 0
end

local function getTouchInterest(tycoon, ...)
    local node = tycoon
    for _, name in ipairs({...}) do
        if not node then return nil end
        node = node:FindFirstChild(name)
    end
    return node
end

local function fireTextButton(btn)
    if not btn then return end
    if btn:IsA("TextButton") or btn:IsA("ImageButton") then
        pcall(function()
            btn.MouseButton1Click:Fire()
        end)
        if firesignal then
            pcall(function()
                firesignal(btn.Activated)
            end)
        end
    end
end

-- // Auto Loops
local function startAutoLoops()
    -- Auto Deposit
    task.spawn(function()
        while Config.Running do
            if Toggles.Deposit then
                if myTycoon and myTycoon.Parent then
                    local mult = getMarketMultiplier(myTycoon)
                    if mult >= Config.MinMultiplier then
                        local ti = getTouchInterest(myTycoon, "Buttons", "Deposit", "Head", "TouchInterest")
                        fireTouchInterest(ti)
                    end
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Merge
    task.spawn(function()
        while Config.Running do
            if Toggles.Merge then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Merge", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Tier Upgrader
    task.spawn(function()
        while Config.Running do
            if Toggles.TierUpgrader then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "TierUpgrader", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Buy Hamsters
    task.spawn(function()
        while Config.Running do
            if Toggles.Hamster then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Add100", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Collect Money
    task.spawn(function()
        while Config.Running do
            if Toggles.CollectMoney then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Cashier", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Collect Drops
    task.spawn(function()
        while Config.Running do
            if Toggles.CollectAllDrops then
                local drops = workspace:FindFirstChild("Drops")
                if drops then
                    for _, dropModel in ipairs(drops:GetChildren()) do
                        local touch = dropModel:FindFirstChild("Touch")
                        if touch then
                            local ti = touch:FindFirstChild("TouchInterest")
                            if ti then
                                fireTouchInterest(ti)
                            end
                        end
                        task.wait(0.02)
                    end
                end
            end
            task.wait(0.05)
        end
    end)

    -- Auto Open Chests (with 5s cooldown)
    task.spawn(function()
        while Config.Running do
            if Toggles.OpenChests then
                local chestDrops = workspace:FindFirstChild("ChestDrops")
                if chestDrops then
                    for _, chest in ipairs(chestDrops:GetChildren()) do
                        if not Toggles.OpenChests or not Config.Running then break end

                        local base = chest:FindFirstChild("Base")
                        if base then
                            local ti = base:FindFirstChild("TouchInterest")
                            if ti then
                                fireTouchInterest(ti)
                            end
                        end
                        task.wait(0.2)

                        local pg = player:FindFirstChild("PlayerGui")
                        local sg = pg and pg:FindFirstChild("ScreenGui")
                        local cf = sg and sg:FindFirstChild("ChestFrame")
                        local infoFrame = cf and cf:FindFirstChild("InfoFrame")
                        local chestInfo = infoFrame and infoFrame:FindFirstChild("ChestInfo")
                        local nameText = chestInfo and chestInfo:FindFirstChild("NameText")

                        local btnFrame = cf and cf:FindFirstChild("ButtonFrame")
                        local unlock = btnFrame and btnFrame:FindFirstChild("Unlock")
                        local discard = btnFrame and btnFrame:FindFirstChild("Discard")

                        local buyBtn = unlock and unlock:FindFirstChild("Button")
                        buyBtn = buyBtn and buyBtn:FindFirstChild("TextButton")

                        local discardBtn = discard and discard:FindFirstChild("Button")
                        discardBtn = discardBtn and discardBtn:FindFirstChild("TextButton")

                        -- Check if current chest name is toggled in multi-selection
                        if nameText and Config.SelectedChests[nameText.Text] then
                            fireTextButton(buyBtn)
                        else
                            fireTextButton(discardBtn)
                        end

                        -- Enforce 5-second cooldown before opening/processing the next chest
                        task.wait(5)
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

-- // Modern UI Construction
local function createToggleRow(parent, labelText, toggleKey)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 36)
    container.BackgroundColor3 = Color3.fromRGB(25, 27, 35)
    container.BorderSizePixel = 0
    container.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(220, 225, 235)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local switchBg = Instance.new("Frame")
    switchBg.Size = UDim2.new(0, 42, 0, 22)
    switchBg.Position = UDim2.new(1, -50, 0.5, -11)
    switchBg.BackgroundColor3 = Color3.fromRGB(45, 48, 60)
    switchBg.BorderSizePixel = 0
    switchBg.Parent = container

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBg

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(180, 185, 200)
    knob.BorderSizePixel = 0
    knob.Parent = switchBg

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.Text = ""
    button.Parent = container

    button.MouseButton1Click:Connect(function()
        Toggles[toggleKey] = not Toggles[toggleKey]
        local state = Toggles[toggleKey]

        local targetBg = state and Color3.fromRGB(88, 101, 242) or Color3.fromRGB(45, 48, 60)
        local targetKnobPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        local targetKnobColor = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 185, 200)

        TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = targetBg}):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {Position = targetKnobPos, BackgroundColor3 = targetKnobColor}):Play()
    end)
end

local function buildUI()
