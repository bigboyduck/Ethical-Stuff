    uninjectBtn.Position = UDim2.new(0, 12, 0, 10)
    uninjectBtn.BackgroundColor3 = Color3.fromRGB(215, 58, 73)
    uninjectBtn.Text = "Uninject Script"
    uninjectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    uninjectBtn.Font = Enum.Font.GothamBold
    uninjectBtn.TextSize = 12
    uninjectBtn.Parent = footer

    local uninjectCorner = Instance.new("UICorner")
    uninjectCorner.CornerRadius = UDim.new(0, 6)
    uninjectCorner.Parent = uninjectBtn

    uninjectBtn.MouseButton1Click:Connect(function()
        Config.Running = false
        gui:Destroy()
    end)

    return gui
end

