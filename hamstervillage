        btnCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            if Config.SelectedChests[name] then
                Config.SelectedChests[name] = nil
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 27, 35), TextColor3 = Color3.fromRGB(180, 185, 200)}):Play()
            else
                Config.SelectedChests[name] = true
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(88, 101, 242), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            end
        end)
    end

    -- Footer Actions
    local footer = Instance.new("Frame")
    footer.Size = UDim2.new(1, 0, 0, 50)
    footer.Position = UDim2.new(0, 0, 1, -50)
    footer.BackgroundColor3 = Color3.fromRGB(22, 23, 31)
    footer.BorderSizePixel = 0
    footer.Parent = mainFrame

    local uninjectBtn = Instance.new("TextButton")
