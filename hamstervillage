-- // Config Persistence (executor file save)
local CONFIG_FILE = "AutoTycoon_Config.json"

local function getExecutorIO()
    local write = writefile or write_file
    local read = readfile or read_file
    if write and read then
        return write, read
    end
    return nil, nil
end

local function saveConfig()
    local write = getExecutorIO()
    if not write then return end

    local data = {
        Config = {
            MinMultiplier = Config.MinMultiplier,
            SelectedChests = Config.SelectedChests,
        },
        Toggles = Toggles,
    }

    pcall(function()
        write(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

local function loadConfig()
    local _, read = getExecutorIO()
    if not read then return end

    local ok, contents = pcall(function()
        return read(CONFIG_FILE)
    end)
    if not ok or not contents then return end

    local decoded
    local ok2 = pcall(function()
        decoded = HttpService:JSONDecode(contents)
    end)
    if not ok2 or type(decoded) ~= "table" then return end

    if type(decoded.Config) == "table" then
        for k, v in pairs(decoded.Config) do
            if Config[k] ~= nil then
                Config[k] = v
            end
        end
        if type(Config.SelectedChests) ~= "table" then
            Config.SelectedChests = {}
        end
    end

    if type(decoded.Toggles) == "table" then
        for k, v in pairs(decoded.Toggles) do
            if Toggles[k] ~= nil then
                Toggles[k] = v and true or false
            end
        end
    end
end

-- // Find Tycoon
local myTycoon = nil

local function findMyTycoon()
    local tycoonFolder = workspace:FindFirstChild("Tycoon")
    if not tycoonFolder then return nil end
    local tycoons = tycoonFolder:FindFirstChild("Tycoons")
    if not tycoons then return nil end

    for _, tycoon in ipairs(tycoons:GetChildren()) do
        local basement = tycoon:FindFirstChild("Basement")
        if basement then
            local profile = basement:FindFirstChild("ProfileAtt")
            if profile then
                local bb = profile:FindFirstChild("BillboardGui")
                if bb then
                    for _, obj in ipairs(bb:GetDescendants()) do
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                            if obj.Text == player.DisplayName or obj.Text == player.Name then
                                return tycoon
                            end
                        end
                        if obj.Name == player.DisplayName or obj.Name == player.Name then
                            return tycoon
                        end
                        if obj:IsA("ImageLabel") and obj.Image ~= "" then
                            if string.find(obj.Image, tostring(player.UserId)) then
                                return tycoon
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // Helper Functions
local function parseNumberFromText(text)
    if not text then return 0 end
    
    local raw = string.gsub(text, "[,%$%s]", "")
    local num, suffix = string.match(raw, "^([%d%.]+)([kKmMbBtT]?)")
    num = tonumber(num) or 0

    if suffix then
        suffix = string.upper(suffix)
        if suffix == "K" then num = num * 1e3
        elseif suffix == "M" then num = num * 1e6
        elseif suffix == "B" then num = num * 1e9
        elseif suffix == "T" then num = num * 1e12
        end
    end

    return num
end

local function fireTouchInterest(touchInterest)
    if not touchInterest or not firetouchinterest then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local part = touchInterest.Parent
    if not part then return end
    pcall(function()
        firetouchinterest(hrp, part, 0)
        task.wait()
        firetouchinterest(hrp, part, 1)
    end)
end

local function getMarketMultiplier(tycoon)
    local essentials = tycoon:FindFirstChild("Essentials")
    if not essentials then return 0 end
    local shop = essentials:FindFirstChild("Shop")
    if not shop then return 0 end
    local md = shop:FindFirstChild("MarketDisplay")
    if not md then return 0 end
    local sg = md:FindFirstChild("SurfaceGui")
    if not sg then return 0 end
    local frame = sg:FindFirstChild("Frame")
    if not frame then return 0 end
    local mf = frame:FindFirstChild("MultipleFrame")
    if not mf then return 0 end
    local mt = mf:FindFirstChild("MultipleText")
    if not mt then return 0 end
    local num = tonumber(string.match(mt.Text, "([%d%.]+)"))
    return num or 0
end

local function getTouchInterest(tycoon, ...)
    local node = tycoon
    for _, name in ipairs({...}) do
        if not node then return nil end
        node = node:FindFirstChild(name)
    end
    return node
end

local function fireTextButton(btn)
    if not btn then return end
    if btn:IsA("TextButton") or btn:IsA("ImageButton") then
        pcall(function()
            btn.MouseButton1Click:Fire()
        end)
        if firesignal then
            pcall(function()
                firesignal(btn.Activated)
            end)
        end
    end
end

-- // Auto Loops
local function startAutoLoops()
    -- Auto Deposit
    task.spawn(function()
        while Config.Running do
            if Toggles.Deposit then
                if myTycoon and myTycoon.Parent then
                    local mult = getMarketMultiplier(myTycoon)
                    if mult >= Config.MinMultiplier then
                        local ti = getTouchInterest(myTycoon, "Buttons", "Deposit", "Head", "TouchInterest")
                        fireTouchInterest(ti)
                    end
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Merge
    task.spawn(function()
        while Config.Running do
            if Toggles.Merge then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Merge", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Tier Upgrader
    task.spawn(function()
        while Config.Running do
            if Toggles.TierUpgrader then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "TierUpgrader", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Selling Seed Upgrade
    task.spawn(function()
        while Config.Running do
            if Toggles.SellingSeedUpgrade then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Upgrade", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Buy Hamsters
    task.spawn(function()
        while Config.Running do
            if Toggles.Hamster then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Add100", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Collect Money
    task.spawn(function()
        while Config.Running do
            if Toggles.CollectMoney then
                if myTycoon and myTycoon.Parent then
                    local ti = getTouchInterest(myTycoon, "Buttons", "Cashier", "Head", "TouchInterest")
                    fireTouchInterest(ti)
                else
                    myTycoon = findMyTycoon()
                end
            end
            task.wait(0.1)
        end
    end)

    -- Auto Collect Drops
    task.spawn(function()
        while Config.Running do
            if Toggles.CollectAllDrops then
                local drops = workspace:FindFirstChild("Drops")
                if drops then
                    for _, dropModel in ipairs(drops:GetChildren()) do
                        local touch = dropModel:FindFirstChild("Touch")
                        if touch then
                            local ti = touch:FindFirstChild("TouchInterest")
                            if ti then
                                fireTouchInterest(ti)
                            end
                        end
                        task.wait(0.02)
                    end
                end
            end
            task.wait(0.05)
        end
    end)

    -- Auto Open Chests / Crates
    task.spawn(function()
        while Config.Running do
            if Toggles.OpenChests then
                local chestDrops = workspace:FindFirstChild("ChestDrops")
                if chestDrops then
                    for _, chest in ipairs(chestDrops:GetChildren()) do
                        if not Toggles.OpenChests or not Config.Running then break end

                        local base = chest:FindFirstChild("Base")
                        if base then
                            local ti = base:FindFirstChild("TouchInterest")
                            if ti then
                                fireTouchInterest(ti)
                            end
                        end

                        -- Wait briefly for chest UI to initialize
                        task.wait(0.2)

                        local pg = player:FindFirstChild("PlayerGui")
                        local sg = pg and pg:FindFirstChild("ScreenGui")

                        local moneyFrame = sg and sg:FindFirstChild("MoneyFrame")
                        local moneyObj = moneyFrame and moneyFrame:FindFirstChild("Money")
                        local playerMoneyLabel = moneyObj and moneyObj:FindFirstChild("AmountText")

                        local cf = sg and sg:FindFirstChild("ChestFrame")
                        local infoFrame = cf and cf:FindFirstChild("InfoFrame")
                        local chestInfo = infoFrame and infoFrame:FindFirstChild("ChestInfo")
                        local nameText = chestInfo and chestInfo:FindFirstChild("NameText")

                        local priceFrame = cf and cf:FindFirstChild("PriceFrame")
                        local frame = priceFrame and priceFrame:FindFirstChild("Frame")
                        local costAmountObj = frame and frame:FindFirstChild("CostAmount")
                        local chestCostLabel = costAmountObj and costAmountObj:FindFirstChild("AmountText")

                        local btnFrame = cf and cf:FindFirstChild("ButtonFrame")
                        local unlock = btnFrame and btnFrame:FindFirstChild("Unlock")
                        local discard = btnFrame and btnFrame:FindFirstChild("Discard")

                        local buyBtn = unlock and unlock:FindFirstChild("Button")
                        buyBtn = buyBtn and buyBtn:FindFirstChild("TextButton")

                        local discardBtn = discard and discard:FindFirstChild("Button")
                        discardBtn = discardBtn and discardBtn:FindFirstChild("TextButton")

                        local currentMoney = parseNumberFromText(playerMoneyLabel and playerMoneyLabel.Text)
                        local chestCost = parseNumberFromText(chestCostLabel and chestCostLabel.Text)

                        local isSelectedChest = nameText and Config.SelectedChests[nameText.Text]
                        local hasEnoughMoney = currentMoney >= chestCost

                        if isSelectedChest and hasEnoughMoney then
                            fireTextButton(buyBtn)
                        else
                            fireTextButton(discardBtn)
                        end

                        -- Necessary UI animation buffer so it doesn't double-interact
                        task.wait(0.3)
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

