    multInput.BackgroundColor3 = Color3.fromRGB(35, 38, 50)
    multInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    multInput.Text = tostring(Config.MinMultiplier)
    multInput.Font = Enum.Font.GothamBold
